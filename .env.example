# Copy to .env and fill in. Never commit .env.

# --- privacy mode -----------------------------------------------------------
# local_only : nothing leaves the container (local ASR + local tone heuristic)
# hybrid     : transcript + numeric measurements leave; audio never does  [default]
# full       : audio itself is sent to a multimodal model
#
# Measured: `full` produced identical tone answers to `hybrid` at every model
# tier tested, so sending audio out buys no accuracy. `hybrid` is the default.
PRIVACY_MODE=hybrid

# --- credentials ------------------------------------------------------------
# Azure OpenAI: sole tone provider. Paid from the first token, no daily quota
# to exhaust — unlike Gemini's old free-tier chain, this can't run out mid-batch.
# Measured 22/24 on the known calls (gpt-5-mini and gpt-4.1-mini both), matching
# the emotion2vec+-corroborated Gemini result exactly.
AZURE_OPENAI_APIKEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# Groq: ASR only now, not tone. Keys begin `gsk_`. Not to be confused with Grok
# (xAI), whose keys begin `xai-`. GROK_API_KEY is accepted as an alias for this
# because the names are so easily confused.
# Used for transcription, where it is ~38x faster than local Whisper.
GROQ_API_KEY=

# Cerebras: optional. Tested and returned 402 Payment Required on a new key —
# the free tier does not cover chat completions, so this stays unused unless
# billing is enabled.
CEREBRAS_API_KEY=

# --- dashboard login --------------------------------------------------------
DASHBOARD_USER=autoace
DASHBOARD_PASSWORD=change-me
SESSION_SECRET=change-me-too

# --- model selection --------------------------------------------------------
# Tone providers, in order. Azure OpenAI is the sole remote provider; local
# always answers so nothing ever fails outright.
TONE_PROVIDER_ORDER=azure_openai,local
GROQ_ASR_MODEL=whisper-large-v3-turbo
ASR_BACKEND=auto

# --- optional ---------------------------------------------------------------
# Licence-gated overlap model; needs an accepted licence and a token.
# OVERLAP_BACKEND=pyannote
# HF_TOKEN=

# v2: second, categorical SER opinion (emotion2vec+, local, no key needed).
# Used narrowly to corroborate the frustrated->upset boundary — see
# app/ser/mapping.py. Default on; set to false to fall back to v1 behaviour
# exactly (LLM tone + wav2vec2-dim only).
SER_ENSEMBLE_ENABLED=true
