# Copy to .env and fill in. Never commit .env.

# --- privacy mode -----------------------------------------------------------
# local_only : nothing leaves the container (local ASR + local tone heuristic)
# hybrid     : transcript + numeric measurements leave; audio never does  [default]
# full       : audio itself is sent to a multimodal model
#
# Measured: `full` produced identical tone answers to `hybrid` at every model
# tier tested, so sending audio out buys no accuracy. `hybrid` is the default.
PRIVACY_MODE=hybrid

# --- credentials ------------------------------------------------------------
# Gemini: best measured tone accuracy, but the free tier allows only ~20
# requests per day PER MODEL, hence the rotation chain below.
GEMINI_API_KEY=

# Groq: keys begin `gsk_`. Not to be confused with Grok (xAI), whose keys begin
# `xai-`. GROK_API_KEY is accepted as an alias for this because the names are
# so easily confused.
# Used for transcription, where it is ~38x faster than local Whisper, and as the
# tone failover once the Gemini daily quota is spent.
GROQ_API_KEY=

# Cerebras: optional. Tested and returned 402 Payment Required on a new key —
# the free tier does not cover chat completions, so this stays unused unless
# billing is enabled.
CEREBRAS_API_KEY=

# --- dashboard login --------------------------------------------------------
DASHBOARD_USER=autoace
DASHBOARD_PASSWORD=change-me
SESSION_SECRET=change-me-too

# --- model selection --------------------------------------------------------
# Tone providers, in order. Gemini leads on accuracy; Groq keeps batches moving
# once Gemini's daily quota is gone; local always answers so nothing ever fails.
TONE_PROVIDER_ORDER=gemini,groq,local
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODEL_CHAIN=gemini-3.5-flash,gemini-flash-latest,gemini-3.5-flash-lite
GROQ_LLM_MODEL=llama-3.3-70b-versatile
ASR_BACKEND=auto

# --- optional ---------------------------------------------------------------
# Licence-gated overlap model; needs an accepted licence and a token.
# OVERLAP_BACKEND=pyannote
# HF_TOKEN=

# v2: second, categorical SER opinion (emotion2vec+, local, no key needed).
# Used narrowly to corroborate the frustrated->upset boundary — see
# app/ser/mapping.py. Default on; set to false to fall back to v1 behaviour
# exactly (LLM tone + wav2vec2-dim only).
SER_ENSEMBLE_ENABLED=true
